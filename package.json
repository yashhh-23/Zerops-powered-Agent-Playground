{
  "name": "zerops-agent-playground",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:db": "npm run build --workspace=packages/db",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "postinstall": "npm run db:generate",
    "start:all": "npx prisma db push --accept-data-loss --schema=packages/db/schema.prisma && concurrently \"npm run start --workspace=apps/api\" \"npx serve apps/web/dist -l 3000 -n -s\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "serve": "^14.2.6"
  }
}
