# Port for Fastify Backend API
PORT=8080

# Managed Postgres database connection string (Supabase / Neon / Local)
DATABASE_URL="postgresql://username:password@localhost:5432/playground?schema=public"

# NATS message queue URL (if using real NATS; otherwise left blank for in-memory queue)
NATS_URL="nats://localhost:4222"

# Hugging Face Inference API token (Phase 4)
LLM_API_KEY="hf_placeholder_token"

# Zerops Public API token (Phase 6)
ZEROPS_API_TOKEN="zerops_placeholder_token"

# Zerops Client ID (Phase 6 project context)
ZEROPS_CLIENT_ID="zerops_placeholder_client_id"

